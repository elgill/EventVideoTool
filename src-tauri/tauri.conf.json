{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Event Video Tool",
  "version": "0.1.0",
  "identifier": "com.eventvideotool.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:ffmpeg && npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:ffmpeg && npm run build",
    "frontendDist": "../dist/eventvideotool-app/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Event Video Tool",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"]
  }
}
