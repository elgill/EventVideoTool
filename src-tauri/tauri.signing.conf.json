{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "createUpdaterArtifacts": true,
    "windows": {
      "signCommand": {
        "cmd": "artifact-signing-cli",
        "args": [
          "-e", "https://eus.codesigning.azure.net",
          "-a", "CGTrustedSigning",
          "-c", "CGTrustedSignCert",
          "-d", "Event Video Tool",
          "%1"
        ]
      }
    }
  }
}
